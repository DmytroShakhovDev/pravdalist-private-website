APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
ALLOWED_HOSTS=private.pravdalist.ai,api.pravdalist.ai,localhost,127.0.0.1

# IP detection
# Set TRUST_PROXY=true ONLY when running behind a reverse proxy (nginx, traefik, cloudflare).
# When true, the app reads the client IP from FORWARDED_HEADER instead of the TCP source IP.
# WARNING: Setting TRUST_PROXY=true without restricting TRUSTED_PROXY_IPS allows IP spoofing
# from any client. In production always set TRUSTED_PROXY_IPS to the IP(s) of your proxy.
TRUST_PROXY=false
FORWARDED_HEADER=x-forwarded-for
# Comma-separated list of proxy IPs allowed to set the forwarded header.
# Leave empty to accept the header from any client (NOT recommended in production).
TRUSTED_PROXY_IPS=
# When true, requests with an unresolvable IP (e.g. missing client info) are not counted
# as violations — prevents a placeholder IP from triggering a global ban.
REQUIRE_REAL_CLIENT_IP=false

DATABASE_URL=postgresql+asyncpg://pravdalist:pravdalist@localhost:5432/pravdalist
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=14
IP_BLOCK_THRESHOLD=5
IP_BLOCK_WINDOW_MINUTES=10
IP_BAN_MINUTES=60
DEFAULT_LANG=ua
SUPPORTED_LANGS=ua,en,ru,de
