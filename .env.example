APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
ALLOWED_HOSTS=private.pravdalist.ai,api.pravdalist.ai,localhost,127.0.0.1
TRUST_PROXY=false
DATABASE_URL=postgresql+asyncpg://pravdalist:pravdalist@localhost:5432/pravdalist
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=14
IP_BLOCK_THRESHOLD=5
IP_BLOCK_WINDOW_MINUTES=10
IP_BAN_MINUTES=60
DEFAULT_LANG=ua
SUPPORTED_LANGS=ua,en,ru,de
